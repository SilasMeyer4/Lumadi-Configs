# ====================================================================
# Lumadi-Config Git Ignore
# ====================================================================

# --- CMake / Build Directories ---
# Ignores standard build folders generated by CMake and IDEs
/cmake-build-*/
/.cmake/
/build/
/out/

# --- CLion / JetBrains IDE ---
# Ignores CLion-specific workspace and cache settings
.idea/

# --- Compiler & Linker Artifacts (Binaries) ---
*.o
*.obj
*.a
*.lib
*.so
*.dylib
*.dll
*.exe
*.pdb
*.gch
*.pch

# --- Operating System Files ---
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Linux
*~
.fuse_hidden*
.directory

# --- Log files & Temporary files ---
*.log
*.tmp
*.bak